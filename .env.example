# Database (Neon PostgreSQL)
# Get from: https://neon.tech
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# JWT Secret for Session Management (INTERNAL AUTH - MVP)
# Generate a random string (32+ characters recommended)
# Example: openssl rand -base64 32
JWT_SECRET="your-secure-random-string-here-change-this-in-production"

# Clerk Authentication (SCALE - Future Migration)
# Get from: https://clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI API Configuration (choose one)
# Claude API (recommended - has prompt caching for 75% token savings)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-xxxxx"

# OpenAI API (alternative)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-xxxxx"

# Admin Configuration
# Comma-separated list of admin email addresses
# These users will have access to the admin dashboard at /admin
ADMIN_EMAILS="admin@example.com,manager@example.com"