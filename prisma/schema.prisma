// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   // INTERNAL: bcrypt hash | SCALE: Remove when using Clerk
  name         String?
  isBlocked    Boolean  @default(false) // Admin can block users from accessing the app
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SCALE: Add when moving to Clerk
  // clerkId   String?  @unique

  clients           Client[]
  generationBatches GenerationBatch[]
  errorLogs         ErrorLog[]

  @@map("users")
}

model Client {
  id               String   @id @default(cuid())
  userId           String
  clientName       String
  clientWebsite    String
  wordpressUrl     String
  wpUsername       String
  wpAppPassword    String // Will be encrypted
  seoPlugin        String // "Yoast" or "RankMath"
  templatePageId   String
  pageBuilder      String   @default("elementor") // "elementor", "divi", "wpbakery", "gutenberg", etc.
  builderDetected  Boolean  @default(false) // Was it auto-detected or manually set?

  // Business metadata for schema.org structured data (all optional)
  businessPhone    String?  // Phone number in format: "+1-555-123-4567"
  businessAddress  String?  // Full address: "123 Main St, Carlsbad, CA 92008"
  businessType     String?  // Schema.org business type: "Plumber", "RoofingContractor", etc.
  gbpUrl           String?  // Google Business Profile URL

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationBatches GenerationBatch[]
  errorLogs         ErrorLog[]

  @@index([userId])
  @@map("clients")
}

model GenerationBatch {
  id               String   @id @default(cuid())
  clientId         String
  userId           String
  csvFilename      String
  totalPages       Int
  successfulPages  Int      @default(0)
  failedPages      Int      @default(0)
  timeTakenSeconds Int      @default(0)
  status           String   @default("in_progress") // "in_progress", "completed", "failed"
  createdAt        DateTime @default(now())

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPages GeneratedPage[]

  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
  @@map("generation_batches")
}

model GeneratedPage {
  id               String   @id @default(cuid())
  batchId          String
  pageName         String
  pageType         String // "Primary Service", "Nested Broad Stroke", "Broad Stroke", "Location Service"
  service          String?  // Service keyword from CSV
  location         String?  // Location from CSV
  parentSlug       String?  // Parent page slug for WordPress hierarchy
  rowNumber        Int?     // Row number from CSV
  publishedUrl     String?
  status           String   @default("pending") // "pending", "generating", "validating", "publishing", "success", "failed"
  errorMessage     String?
  primaryKeyword   String?
  generatedContent String?  @db.Text // JSON string of generated content
  timeElapsed      Int      @default(0) // milliseconds
  createdAt        DateTime @default(now())

  batch               GenerationBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pageGenerationLogs  PageGenerationLog[]

  @@index([batchId])
  @@index([status])
  @@map("generated_pages")
}

model PageGenerationLog {
  id          String   @id @default(cuid())
  pageId      String
  batchId     String
  clientId    String
  logLevel    String   // "info", "warn", "error", "debug"
  stage       String   // "generation", "validation", "regeneration", "publishing", "elementor"
  message     String   @db.Text
  data        String?  @db.Text // JSON string with detailed context (params, responses, etc.)
  duration    Int?     // milliseconds (for performance tracking)
  createdAt   DateTime @default(now())

  page   GeneratedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([batchId])
  @@index([clientId])
  @@index([stage])
  @@index([logLevel])
  @@index([createdAt])
  @@map("page_generation_logs")
}

model ErrorLog {
  id           String   @id @default(cuid())
  userId       String
  clientId     String?
  errorType    String // "generation", "validation", "wordpress", "api", "queue", "user_input"
  errorMessage String   @db.Text
  stackTrace   String?  @db.Text
  context      String?  @db.Text // JSON string with additional context
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([errorType])
  @@index([createdAt])
  @@map("error_logs")
}